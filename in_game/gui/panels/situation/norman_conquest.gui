situation_panel = {

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################

	# Cards sit DIRECTLY in the blockoverride, no wrapping vbox — vanilla's
	# rise_of_the_ottomans.gui (the readme's recommended base) does the same
	# with its two cards. A wrapping expanding vbox distributed the free
	# space BETWEEN the cards, which looked like a huge gap in game.

	blockoverride "situation_panel_main_content" {

		# CARD 1: SITUATION DESCRIPTION
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'nc_desc_toggled' )]"
			}
			blockoverride "header_text" {
				text = "norman_conquest"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/traits/_default.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					margin = { 15 10 }
					layoutpolicy_horizontal = expanding
					max_width = 460
					autoresize = yes
					text = "norman_conquest_desc"
					# Font_Size_Medium: preload/fonts.gui:21; the old
					# fontsize_medium had ZERO vanilla uses (AUDIT D4).
					using = Font_Size_Medium
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'nc_desc_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'nc_desc_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'nc_desc_toggled' ))]"
			}
		}

		# CARD 2: END REQUIREMENTS
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'nc_req_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			# No hint blockoverrides: this situation has no scriptable
			# hint, and blanking visible_hint would SHOW the hint button
			# (template default is visible = no, cards.gui:2537-2539)
			# while blanking onaction_hint killed its action — a visible
			# dead button (AUDIT D5). Leaving both alone is the shape 8
			# vanilla cards use; CARD 1 above already does the same.
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'nc_req_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'nc_req_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'nc_req_toggled' ))]"
			}
		}
	}

}
